<?xml version="1.0" encoding="utf-8"?>
<!--
  packageNames limits this service to Money Manager: Android does not deliver
  events or screen content from any other app (banking apps included).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="100"
    android:packageNames="com.realbyteapps.moneymanagerfree,com.realbyteapps.moneymanager" />
